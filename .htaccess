RewriteEngine On

# Pastikan semua menggunakan HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect semua subfolder & path ke halaman utama domain
RewriteCond %{HTTP_HOST} ^kakekzeus\.dontkillmyapp\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.*)$ https://kakekzeus.dontkillmyapp.com/ [L,R=301]
